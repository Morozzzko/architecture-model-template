---
import Editor from './Editor.jsx'
import { fieldOf, people } from './fields.js'
import { hrefWithBase, optionsOf, valuesOf } from './metadata.js'
import { model } from './model.js'

interface Props {
  of: string
  name: string
}

type Option = string | { value: string; label?: string; href?: string }

const types = ['text', 'number', 'date', 'url', 'boolean', 'select', 'multiselect', 'people']

const { of, name } = Astro.props
const field: { type: string; options?: Option[] } = fieldOf(name)
if (!types.includes(field.type)) {
  throw new Error(`Unknown type "${field.type}" for metadata "${name}". Known types: ${types.join(', ')}`)
}

const values = valuesOf(model.element(of), name)
const listed = optionsOf({ options: field.type === 'people' ? people() : field.options })
const labels = new Map(listed.map((option) => [option.value, option.label]))
const hrefs = new Map(
  listed.filter((option) => option.href).map((option) => [option.value, hrefWithBase(option.href!, import.meta.env.BASE_URL)]),
)
const inUse = [...new Set([...model.elements()].flatMap((element) => valuesOf(element, name)))]
const options = [...listed, ...inUse.filter((value) => !labels.has(value)).map((value) => ({ value, label: value }))]
const linkedValues = values.map((value) => ({ text: labels.get(value) ?? value, href: hrefs.get(value) }))

const text =
  field.type === 'boolean' && values.length
    ? values[0] === 'true'
      ? 'Yes'
      : 'No'
    : values.map((value) => labels.get(value) ?? value).join(', ')
---

{
  import.meta.env.DEV ? (
    <Editor
      client:load
      fqn={of}
      name={name}
      type={field.type === 'people' ? 'multiselect' : field.type}
      values={values}
      options={options}
    />
  ) : field.type === 'url' && text ? (
    <a href={text}>{text}</a>
  ) : field.type === 'boolean' ? (
    text
  ) : (
    linkedValues.map(({ text: value, href }, index) => (
      <>{index > 0 && ', '}{href ? <a href={href}>{value}</a> : value}</>
    ))
  )
}

specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element container
  element external {
    style {
      color muted
    }
  }
}

model {
  user = actor 'User' {
    description 'A user of the system.'
  }
  system = system 'Software System' {
    description 'A software system.'

    webapp = container 'Web App' {
      technology 'Web application'
      description 'Primary user-facing interface.'
    }
  }
  email = external 'Email Provider' {
    description 'Sends email on behalf of the system.'
  }

  user -> system.webapp 'Signs in and works with'
  system.webapp -> email 'Sends notifications through' {
    technology 'HTTPS'
  }
}

views {
  view index {
    title 'Landscape'
    include *
  }

  view context {
    title 'Context'
    include system, * -> system, system -> *
  }

  view containers of system {
    title 'Containers'
    include *, user, email
  }

  dynamic view userRequestFlow {
    title 'User request flow'
    user -> system.webapp 'Signs in and works with'
    system.webapp -> email 'Sends notifications through'
  }
}

{
  "name": "architecture-model-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "likec4 build model --output dist/diagrams --base ./ --use-hash-history && node bin/add-documentation-link.js",
    "preview": "astro preview",
    "test": "node --test bin/*.test.js",
    "validate": "likec4 validate model && likec4 validate examples/shop && likec4 format --check .",
    "export": "likec4 export"
  },
  "dependencies": {
    "@architecture-model/editable-metadata": "^0.1.0",
    "@astrojs/react": "^7.0.1",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.8",
    "likec4": "^1.59.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}

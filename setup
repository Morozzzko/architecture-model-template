#!/usr/bin/env bash
#
# One-time setup: renames template placeholders.
#
# Usage: ./setup

set -euo pipefail

# ── Colour helpers (only when writing to a real terminal) ──────────────────────
if [ -t 1 ]; then
  BOLD='\033[1m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  RED='\033[0;31m'
  RESET='\033[0m'
else
  BOLD='' GREEN='' YELLOW='' CYAN='' RED='' RESET=''
fi

say()  { printf "${CYAN}==> ${RESET}%s\n" "$*"; }
ok()   { printf "${GREEN}    ✓ ${RESET}%s\n" "$*"; }
err()  { printf "${RED}    ✗ ${RESET}%s\n" "$*" >&2; }

# ── Prompt helper: read with a default ────────────────────────────────────────
# Usage: ask "Question text" "default value" → sets REPLY
ask() {
  local prompt="$1" default="$2"
  if [[ -n "$default" ]]; then
    printf "${BOLD}%s${RESET} [%s]: " "$prompt" "$default"
  else
    printf "${BOLD}%s${RESET}: " "$prompt"
  fi
  read -r REPLY
  if [[ -z "$REPLY" ]]; then
    REPLY="$default"
  fi
}

# ── Yes/no prompt ─────────────────────────────────────────────────────────────
# Usage: confirm "Question" → returns 0 for yes, 1 for no
confirm() {
  printf "${BOLD}%s${RESET} [y/N]: " "$1"
  read -r _ans
  [[ "$_ans" =~ ^[Yy]$ ]]
}

# ── In-place replace (portable across macOS and Linux) ────────────────────────
# Usage: replace "old" "new" file
replace() {
  local old="$1" new="$2" file="$3"
  if ! grep -qF -- "$old" "$file"; then
    err "$old not found in $file. Has setup already been run? Edit the file directly."
    exit 1
  fi
  OLD="$old" NEW="$new" perl -i -pe 's/\Q$ENV{OLD}\E/$ENV{NEW}/g' "$file"
}

# ── Banner ─────────────────────────────────────────────────────────────────────
echo ""
printf "${BOLD}Architecture Model Template — Setup${RESET}\n"
echo "Customises placeholder names in the model and the site title."
echo ""

# ── Step 1: Collect names ─────────────────────────────────────────────────────
say "Project details"

ask "Project name (used as the site title)" "My Project"
PROJECT_NAME="$REPLY"

ask "Main software system name" "$PROJECT_NAME"
SYSTEM_NAME="$REPLY"

ask "Main user / actor name" "User"
USER_NAME="$REPLY"

ask "Main container / component name" "Web App"
WEBAPP_NAME="$REPLY"

for name in "$PROJECT_NAME" "$SYSTEM_NAME" "$USER_NAME" "$WEBAPP_NAME"; do
  if [[ "$name" == *"'"* || "$name" == *'"'* || "$name" == *\\* ]]; then
    err "Names cannot contain quotes or backslashes: $name"
    exit 1
  fi
done

echo ""

# ── Step 2: Apply replacements ────────────────────────────────────────────────
say "Applying replacements to model/model.c4"

replace "'Software System'" "'${SYSTEM_NAME}'" model/model.c4
ok "'Software System' → '${SYSTEM_NAME}'"

replace "'Web App'" "'${WEBAPP_NAME}'" model/model.c4
ok "'Web App' → '${WEBAPP_NAME}'"

replace "'User'" "'${USER_NAME}'" model/model.c4
ok "'User' → '${USER_NAME}'"

say "Applying replacements to astro.config.mjs"

replace "title: 'Architecture'" "title: '${PROJECT_NAME}'" astro.config.mjs
ok "site title → '${PROJECT_NAME}'"

# ── Done ──────────────────────────────────────────────────────────────────────
echo ""
printf "${GREEN}${BOLD}Setup complete!${RESET}\n"
echo ""
echo "Next steps:"
echo "  1. Run  npm install"
echo "  2. Run  npm run dev"
echo "  3. Open  http://localhost:4321  to view the site"
echo ""

# ── Step 3: Optional — self-removal ───────────────────────────────────────────
if confirm "Remove this setup script? (it's no longer needed)"; then
  rm -- "$0"
  ok "setup script removed"
fi

---
import { existsSync, readFileSync } from 'node:fs'
import config from 'virtual:editable-metadata/config'
import Editor from './Editor.jsx'
import { model } from './model.js'

interface Props {
  of: string
  name: string
}

type Option = string | { value: string; label?: string }

const types = ['text', 'number', 'date', 'url', 'boolean', 'select', 'multiselect']

const { of, name } = Astro.props
const fields = existsSync(config.fieldsFile) ? JSON.parse(readFileSync(config.fieldsFile, 'utf8')) : {}
const field: { type: string; options?: Option[] } = fields[name] ?? { type: 'text' }
if (!types.includes(field.type)) {
  throw new Error(`Unknown type "${field.type}" for metadata "${name}". Known types: ${types.join(', ')}`)
}

const valuesOf = (fqn: string) => [model.element(fqn).getMetadata(name) ?? []].flat()
const values = valuesOf(of)
const listed = (field.options ?? []).map((option) =>
  typeof option === 'string' ? { value: option, label: option } : { value: option.value, label: option.label ?? option.value },
)
const labels = new Map(listed.map((option) => [option.value, option.label]))
const inUse = [...new Set([...model.elements()].flatMap((element) => valuesOf(element.id)))]
const options = [...listed, ...inUse.filter((value) => !labels.has(value)).map((value) => ({ value, label: value }))]

const text =
  field.type === 'boolean' && values.length
    ? values[0] === 'true'
      ? 'Yes'
      : 'No'
    : values.map((value) => labels.get(value) ?? value).join(', ')
---

{
  import.meta.env.DEV ? (
    <Editor client:load fqn={of} name={name} type={field.type} values={values} options={options} />
  ) : field.type === 'url' && text ? (
    <a href={text}>{text}</a>
  ) : (
    text
  )
}

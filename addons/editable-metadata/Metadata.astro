---
import { existsSync, readFileSync } from 'node:fs'
import config from 'virtual:editable-metadata/config'
import Editor from './Editor.jsx'
import { model } from './model.js'

interface Props {
  of: string
  name: string
}

const types = ['text', 'number', 'date', 'url', 'boolean', 'select', 'multiselect']

const { of, name } = Astro.props
const fields = existsSync(config.fieldsFile) ? JSON.parse(readFileSync(config.fieldsFile, 'utf8')) : {}
const field: { type: string; options?: string[] } = fields[name] ?? { type: 'text' }
if (!types.includes(field.type)) {
  throw new Error(`Unknown type "${field.type}" for metadata "${name}". Known types: ${types.join(', ')}`)
}

const valuesOf = (fqn: string) => [model.element(fqn).getMetadata(name) ?? []].flat()
const values = valuesOf(of)
const inUse = [...model.elements()].flatMap((element) => valuesOf(element.id))
const options = [...new Set([...(field.options ?? []), ...inUse])]

const text = field.type === 'boolean' && values.length ? (values[0] === 'true' ? 'Yes' : 'No') : values.join(', ')
---

{
  import.meta.env.DEV ? (
    <Editor client:load fqn={of} name={name} type={field.type} values={values} options={options} />
  ) : field.type === 'url' && text ? (
    <a href={text}>{text}</a>
  ) : (
    text
  )
}

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

export function getStaticPaths() {
  const decisions = import.meta.glob('../../../docs/decisions/[0-9]*.md', { eager: true })
  return Object.entries(decisions).map(([path, decision]) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
    props: { decision },
  }))
}

const { decision } = Astro.props
const [title, ...headings] = decision.getHeadings()
const html = (await decision.compiledContent())
  .replace(/<h1[^>]*>.*?<\/h1>/s, '')
  .replace(/href="(\d+-[^"/]+)\.md"/g, 'href="../$1/"')
---

<StarlightPage frontmatter={{ title: title.text }} headings={headings}>
  <Fragment set:html={html} />
</StarlightPage>
